# A key is the only requirement. OpenAI or Anthropic - the app detects which from the prefix.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Models. gpt-5.4-mini is ~3x faster than gpt-5.5 at the same measured score.
OPENAI_MODEL=gpt-5.4-mini
# JUDGE_MODEL=
# ANTHROPIC_MODEL=claude-opus-5

# Set in production, or every redeploy signs all users out.
# SECRET_KEY=

# Storage. Leave DATABASE_URL empty for SQLite.
# DATABASE_URL=postgresql://...
# DB_PATH=./data.db

# Quota and plan
# FREE_RESUMES=1
# PLAN_DAYS=30
# PLAN_AMOUNT_PAISE=29900
# BYOK_ONLY=1

# Sign-in. Redirect URI: <your-domain>/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Billing. Webhook: <your-domain>/webhook/razorpay  (payment_link.paid, payment.captured)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Set behind TLS so the session cookie is marked Secure.
# HTTPS=1
